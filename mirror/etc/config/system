
config system
	option hostname 'OpenWrt'
	option timezone 'MSK-3'
	option zonename 'Europe/Moscow'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option compat_version '1.0'
	option zram_size_mb '150'
	option cronloglevel '9'

config timeserver 'ntp'
	option enabled '1'
	option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'

config led
	option name 'blue_status_off'
	option sysfs 'blue:status'
	option trigger 'none'
	option default '0'

config led
	option name 'yellow_status_off'
	option sysfs 'yellow:status'
	option trigger 'none'
	option default '0'

