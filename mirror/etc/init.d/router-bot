#!/bin/sh /etc/rc.common
# Команды роутеру из Telegram (/status, /nodes, /restart …). Сам бот — /usr/bin/router-notify --bot.
# Пока уведомления не настроены (vpn tg setup), просто ждёт.
USE_PROCD=1
START=99

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/router-notify --bot
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
